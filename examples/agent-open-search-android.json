{
  "schemaVersion": 1,
  "id": "android.openSettingsSearch",
  "goal": "打开设置的搜索页。调用 request_view 查看批准的搜索入口，然后在提供的截图区域内选择坐标并调用 tap_visual。",
  "apps": [
    "com.android.settings",
    "com.google.android.settings.intelligence"
  ],
  "actions": [
    {
      "name": "openSearch",
      "app": "com.android.settings",
      "visual": true,
      "step": {
        "action": "tap",
        "id": "com.android.settings:id/search_bar"
      }
    }
  ],
  "checkpoints": [
    {
      "name": "searchPageVisible",
      "app": "com.google.android.settings.intelligence",
      "afterAction": "openSearch",
      "target": {
        "id": "com.google.android.settings.intelligence:id/open_search_view_edit_text"
      }
    }
  ]
}
