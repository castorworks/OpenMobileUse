{
  "schemaVersion": 1,
  "id": "harmony.openSettingsSearch",
  "goal": "打开设置的搜索页。调用 request_view 查看批准的搜索入口，然后在提供的截图区域内选择坐标并调用 tap_visual。",
  "apps": [
    "com.huawei.hmos.settings"
  ],
  "actions": [
    {
      "name": "openSearch",
      "app": "com.huawei.hmos.settings",
      "visual": true,
      "step": {
        "action": "tap",
        "id": "homPageSearchInputColumn"
      }
    }
  ],
  "checkpoints": [
    {
      "name": "searchPageVisible",
      "app": "com.huawei.hmos.settings",
      "afterAction": "openSearch",
      "target": {
        "id": "__SearchField__searchComponent"
      }
    }
  ]
}
