{
  "name": "open-mobile-use",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "omu": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc && node scripts/prepare-screen-text.mjs",
    "omu": "node dist/cli.js",
    "appium": "appium --address 127.0.0.1 --log-level warn",
    "build:desktop": "npm run build && node desktop/build-ocr.mjs",
    "package:desktop": "npm run build:desktop && node desktop/package-mac.mjs",
    "desktop": "npm run build:desktop && npm --prefix desktop start"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0",
    "npm": ">=10"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "appium": "3.9.1",
    "appium-uiautomator2-driver": "8.7.3",
    "appium-xcuitest-driver": "12.22.8",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@tesseract.js-data/chi_tra": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@xmldom/xmldom": "0.9.12",
    "sharp": "0.35.5",
    "tesseract.js": "7.0.0"
  }
}
